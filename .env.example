# Address of the backend API (no trailing slash).
#
# Local development: copy this file to .env.local
#   cp .env.example .env.local
#
# On AWS Amplify: do NOT use a file. Add an environment variable in the
# Amplify console instead (Hosting > Environment variables):
#   VITE_API_URL = https://13-250-1-2.sslip.io
# Vite bakes this value into the build, so redeploy after changing it.
VITE_API_URL=http://localhost:3000
